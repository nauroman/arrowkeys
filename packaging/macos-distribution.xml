<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>ArrowKeys</title>
  <background file="ArrowKeys.png" alignment="bottomleft" scaling="none"/>
  <background-darkAqua file="ArrowKeys.png" alignment="bottomleft" scaling="none"/>
  <welcome file="welcome.rtf"/>
  <conclusion file="finish.rtf"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <volume-check><allowed-os-versions><os-version min="13.0"/></allowed-os-versions></volume-check>
  <options customize="never" hostArchitectures="x86_64,arm64" require-scripts="true"/>
  <choices-outline><line choice="app"/></choices-outline>
  <choice id="app" visible="false"><pkg-ref id="com.nauroman.arrowkeys.native"/></choice>
  <pkg-ref id="com.nauroman.arrowkeys.native" version="1.1.1">#ArrowKeysApp.pkg</pkg-ref>
</installer-gui-script>
