#!/bin/bash
set -eu
# Start the installed app in the active desktop session. Offline installations
# and Macs at the login window have no keyboard session to configure.
[[ "$3" == / ]] || exit 0
account=$(/usr/bin/stat -f '%Su' /dev/console)
case "$account" in ''|root|loginwindow|_*) exit 0 ;; esac
uid=$(/usr/bin/id -u "$account")
/bin/launchctl print "gui/$uid" >/dev/null 2>&1 || exit 0
if ! /bin/launchctl asuser "$uid" /usr/bin/sudo -H -u "#$uid" /usr/bin/open -g "/Applications/ArrowKeys.app"; then
  echo 'ArrowKeys is installed. Open it from Applications to start keyboard navigation.' >&2
fi
