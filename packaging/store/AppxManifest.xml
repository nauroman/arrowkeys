      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="ArrowKeys.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ArrowKeysStartup" Enabled="false" DisplayName="ArrowKeys"/>
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust"/></Capabilities>
</Package>
