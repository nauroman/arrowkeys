{
  "title": "ArrowKeys",
  "rules": [{
    "description": "ArrowKeys: Caps Lock as Option, with home-row navigation",
    "manipulators": [
      {
        "type": "basic",
        "from": { "key_code": "caps_lock", "modifiers": { "optional": ["any"] } },
        "to": [{ "key_code": "left_option" }]
      },
      {
        "type": "basic",
        "from": { "key_code": "j", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "left_arrow" }]
      },
      {
        "type": "basic",
        "from": { "key_code": "k", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "down_arrow" }]
      },
      {
        "type": "basic",
        "from": { "key_code": "l", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "right_arrow" }]
      },
      {
        "type": "basic",
        "from": { "key_code": "i", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "up_arrow" }]
      },
      {
        "type": "basic",
        "from": { "key_code": "u", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "left_arrow", "modifiers": ["left_command"] }]
      },
      {
        "type": "basic",
        "from": { "key_code": "o", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "right_arrow", "modifiers": ["left_command"] }]
      },
      {
        "type": "basic",
        "from": { "key_code": "h", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "left_arrow", "modifiers": ["left_option"] }]
      },
      {
        "type": "basic",
        "from": { "key_code": "semicolon", "modifiers": { "mandatory": ["option"] } },
        "to": [{ "key_code": "right_arrow", "modifiers": ["left_option"] }]
      }
    ]
  }]
}
